// nextflow.config

params {
  // Qiime2 release, used to pick the container and to name the classifiers
  qiime2_version = "2026.10"

  version = "2025-02-19"
  // See column Release date in table 'QIIME releases' on https://unite.ut.ee/repository.php
  // Major Unite version/date is not iterable by design, as I only run on new releases

  taxon_group = ["fungi", "eukaryotes"]
  // "fungi", "eukaryotes"

  cluster_id = ["99", "97", "dynamic"]
  // "99", "97", "dynamic"

  singletons = [false]
  // or true, which is worse, see https://github.com/colinbrislawn/unite-train/issues/17#issuecomment-3836231283

  outdir = "./results"

  // For repoprts
  timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm')
}

// Apple container is the default, see https://github.com/colinbrislawn/unite-train/issues/20
// Needs Apple silicon and `container system start`
appleContainer {
  enabled = true
  // Qiime2 images are linux/amd64 only, so run them with Rosetta
  runOptions = '--rosetta --platform linux/amd64'
}

process {
  // Each task runs in its own VM sized by cpus and memory. Without this,
  // tasks that don't set memory get the container default of 1 GB.
  // (Set here, not under withLabel, so memory in main.nf still wins.)
  memory = '8 GB'

  withLabel: 'qiime2' {
    container = "quay.io/qiime2/qiime2-workshop:${params.qiime2_version}"
    ext.qiime2_version = params.qiime2_version
  }
}

profiles {
  // Old way: nextflow run main.nf -profile pixi
  pixi {
    appleContainer.enabled = false
    process {
      withLabel: 'qiime2' {
        container = null
        // Dynamically evaluate the Pixi environment before the script runs
        beforeScript = "eval \"\$(pixi shell-hook --manifest-path ${baseDir}/pixi.toml)\""

        // Pull it from the pixi.toml file, should look like "0000.0 or 0000.00"
        ext.qiime2_version = {
          def toml = new File("${baseDir}/pixi.toml").text
          (toml =~ /qiime2\/(\d+\.\d+)\/qiime2/)[0][1]
        }()
      }
    }
  }
}

report {
    enabled = true
    overwrite = true
    file = "${launchDir}/results/report_${params.timestamp}.html"
}

timeline {
    enabled = true
    overwrite = true
    file = "${launchDir}/results/timeline_${params.timestamp}.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${launchDir}/results/trace_${params.timestamp}.tsv"
}
